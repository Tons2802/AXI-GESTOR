    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst faltam = JSON.parse(item.FALTAM || '[]');\nconst results = [];\n\nconst agora = new Date();\nconst dataObj = new Date(agora.toLocaleString('en-US', {timeZone: 'America/Sao_Paulo'}));\nconst data = dataObj.getFullYear() + '-' +\n  String(dataObj.getMonth()+1).padStart(2,'0') + '-' +\n  String(dataObj.getDate()).padStart(2,'0');\n\n// Gera OS para cada componente que falta\nfor (const falta of faltam) {\n  for (const comp of falta.componentes) {\n    const qtdComp = comp.quantidade * falta.qtdFalta;\n    results.push({\n      json: {\n        ID_OS: falta.idOS,\n        PRODUTO: falta.produto,\n        COMPONENTES: comp.componente,\n        QTD: qtdComp,\n        DATA: data,\n        OPERADOR: '',\n        STATUS: '',\n        QTD_PROD_FINAL: falta.qtdFalta,\n        OBS: 'REPOSIÇÃO',\n        CLIENTE: 'ESTOQUE',\n        N_PEDIDO: 'INTERNO',\n        row_number: item.row_number,\n        _tipo: 'OS'\n      }\n    });\n  }\n}\n\n// Retorna também o item de MONTAGEM original\nresults.push({\n  json: {\n    CLIENTE: item.CLIENTE,\n    PRODUTO: item.PRODUTO,\n    QTD: item.QTD,\n    N_PEDIDO: item.N_PEDIDO,\n    DATA: item.DATA,\n    OBS: item.OBS,              // ← OBS original do vendedor\n    'SITUAÇÃO': item['SITUAÇÃO'], // ← campo do sistema\n    'PRODUÇÃO': item['PRODUÇÃO'],\n    row_number: item.row_number,\n    _tipo: 'MONTAGEM'\n  }\n});\n\nreturn results;"
      },
