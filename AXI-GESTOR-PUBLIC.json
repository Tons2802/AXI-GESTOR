    {
      "parameters": {
        "jsCode": "const allRows = $('Get row(s) in sheet3').all();\nconst nivel2Rows = $('NIVEL_2').all();\nconst results = [];\nconst estoqueCalc = {};\n\nconst produtosComEstoque = [\n  'JAGUAR 10L', 'JAGUAR 30L', 'JAGUAR 60L', 'JAGUAR 90L',\n  'JSN SUPORTE 100L', 'JSN SUPORTE 20L', 'JSN SUPORTE 40L', 'JSN SUPORTE 60L',\n  'LP 100L', 'LP 60L', 'PAPELEIRA P2 LP 50L',\n  'CESTO JAGUAR 10L BRANCO', 'CESTO JAGUAR 30L BRANCO', 'CESTO JAGUAR 60L BRANCO', 'CESTO JAGUAR 93L BRANCO',\n  'CESTO JAGUAR 10L PRETO', 'CESTO JAGUAR 30L PRETO', 'CESTO JAGUAR 60L PRETO', 'CESTO JAGUAR 93L PRETO',\n  'CESTO JSN 20L', 'CESTO JSN 40L', 'CESTO JSN 60L', 'CESTO JSN 100L',\n  'QUADRO BOLA 60L', 'QUADRO BOLA 100L', 'VARAO B2', 'VARAO B3'\n];\n\nfor (const row of allRows) {\n  const produto = row.json['PRODUTO'];\n  const quantidade = Number(row.json['QUANTIDADE']);\n  const nivel2Componentes = nivel2Rows.filter(n => n.json['PRODUTO'] === produto);\n\n  if (nivel2Componentes.length > 0) {\n    for (const n2 of nivel2Componentes) {\n      const compN2 = n2.json['COMPONENTE'];\n      const qtdN2 = Number(n2.json['QUANTIDADE']) * quantidade;\n\n      const estoqueRow = $('Get row(s) in sheet5').all()\n        .find(e => e.json['PRODUTO'] === compN2);\n\n      const qtdDisponivel = estoqueRow ? Number(estoqueRow.json['QTD DISPONIVEL']) : 0;\n      const margem = estoqueRow ? Number(estoqueRow.json['MARGEM DE SEGURANÇA']) || 0 : 0;\n      const estoqueRowNumber = estoqueRow ? estoqueRow.json['row_number'] : null;\n\n      if (!estoqueCalc[compN2]) {\n        estoqueCalc[compN2] = { qtd: 0, row_number: estoqueRowNumber, qtdDisponivel, margem };\n      }\n      estoqueCalc[compN2].qtd += qtdN2;\n    }\n\n  } else if (produtosComEstoque.includes(produto)) {\n    const estoqueRow = $('Get row(s) in sheet5').all()\n      .find(e => e.json['PRODUTO'] === produto);\n\n    const qtdDisponivel = estoqueRow ? Number(estoqueRow.json['QTD DISPONIVEL']) : 0;\n    const margem = estoqueRow ? Number(estoqueRow.json['MARGEM DE SEGURANÇA']) || 0 : 0;\n    const estoqueRowNumber = estoqueRow ? estoqueRow.json['row_number'] : null;\n\n    if (!estoqueCalc[produto]) {\n      estoqueCalc[produto] = { qtd: 0, row_number: estoqueRowNumber, qtdDisponivel, margem };\n    }\n    estoqueCalc[produto].qtd += quantidade;\n  }\n}\n\nconst osGerada = {};\n\nfor (const row of allRows) {\n  const produto = row.json['PRODUTO'];\n  const quantidade = Number(row.json['QUANTIDADE']);\n  const rowNumber = row.json['row_number'];\n  const cliente = row.json['CLIENTE'];\n  const nPedido = row.json['Nº do Pedido'] ?? row.json['No do Pedido'] ?? row.json['N_PEDIDO'] ?? '';\n  const obs = row.json['OBS'] ?? '';\n\n  const agora = new Date();\n  const dataObj = new Date(agora.toLocaleString('en-US', {timeZone: 'America/Sao_Paulo'}));\n  const data = dataObj.getFullYear() + '-' +\n    String(dataObj.getMonth()+1).padStart(2,'0') + '-' +\n    String(dataObj.getDate()).padStart(2,'0');\n\n  const idOS = 'OS-' +\n    String(agora.getDate()).padStart(2,'0') +\n    String(agora.getMonth()+1).padStart(2,'0') +\n    String(agora.getHours()).padStart(2,'0') +\n    String(agora.getMinutes()).padStart(2,'0') +\n    '-' + rowNumber;\n\n  const nivel2Componentes = nivel2Rows.filter(n => n.json['PRODUTO'] === produto);\n\n  if (nivel2Componentes.length > 0) {\n    const faltam = [];\n    const faltamDetalhes = [];\n\n    for (const n2 of nivel2Componentes) {\n      const compN2 = n2.json['COMPONENTE'];\n      const qtdN2 = Number(n2.json['QUANTIDADE']) * quantidade;\n      const info = estoqueCalc[compN2] || { qtd: 0, qtdDisponivel: 0, margem: 0 };\n\n      const estoqueRowAtual = $('Get row(s) in sheet5').all()\n        .find(e => e.json['PRODUTO'] === compN2);\n      const margemAtual = estoqueRowAtual ? Number(estoqueRowAtual.json['MARGEM DE SEGURANÇA']) || 0 : 0;\n      const estoqueApos = info.qtdDisponivel - info.qtd;\n\n      const faltaEstoque = info.qtdDisponivel < qtdN2;\n      const abaixoMargem = estoqueApos < margemAtual && !faltaEstoque;\n\n      if ((faltaEstoque || abaixoMargem) && !faltamDetalhes.find(f => f.produto === compN2)) {\n        if (faltaEstoque && !faltam.includes(compN2)) {\n          faltam.push(compN2);\n        }\n        const qtdProduzir = margemAtual > 0 ? margemAtual - estoqueApos : Math.abs(estoqueApos);\n        const estruturaComps = $('Get row(s) in sheet4').all()\n          .filter(c => c.json['Produto'] === compN2)\n          .map(c => ({\n            componente: c.json['Componente'],\n            quantidade: Number(c.json['Quantidade'])\n          }));\n        faltamDetalhes.push({\n          produto: compN2,\n          qtdFalta: qtdProduzir,\n          margem: margemAtual,\n          idOS: idOS,\n          componentes: estruturaComps\n        });\n      }\n    }\n\n    const faltamUnicos = [...new Set(faltam)];\n    const producao = faltamUnicos.length > 0 ? 'SIM' : 'NÃO';\n    // ← OBS separada da SITUAÇÃO\n    const situacao = faltamUnicos.length > 0 ? 'Falta: ' + faltamUnicos.join(', ') : '';\n\n    results.push({\n      json: {\n        CLIENTE: cliente,\n        PRODUTO: produto,\n        QTD: quantidade,\n        N_PEDIDO: nPedido,\n        DATA: data,\n        OBS: obs,              // ← OBS original do vendedor\n        'SITUAÇÃO': situacao,  // ← campo do sistema\n        'PRODUÇÃO': producao,\n        FALTAM: JSON.stringify(faltamDetalhes),\n        row_number: rowNumber,\n        _tipo: 'MONTAGEM'\n      }\n    });\n\n  } else if (produtosComEstoque.includes(produto)) {\n    const info = estoqueCalc[produto] || { qtd: 0, qtdDisponivel: 0, margem: 0 };\n\n    const estoqueRowAtual = $('Get row(s) in sheet5').all()\n      .find(e => e.json['PRODUTO'] === produto);\n    const margemAtual = estoqueRowAtual ? Number(estoqueRowAtual.json['MARGEM DE SEGURANÇA']) || 0 : 0;\n    const estoqueApos = info.qtdDisponivel - info.qtd;\n\n    const temEstoque = info.qtdDisponivel >= quantidade;\n    const producao = temEstoque ? 'NÃO' : 'SIM';\n    // ← OBS separada da SITUAÇÃO\n    const situacao = !temEstoque ? 'Falta: ' + produto : '';\n\n    const faltamDetalhes = [];\n    if (!temEstoque) {\n      const qtdProduzir = margemAtual > 0 ? margemAtual - estoqueApos : Math.abs(estoqueApos);\n      const estruturaComps = $('Get row(s) in sheet4').all()\n        .filter(c => c.json['Produto'] === produto)\n        .map(c => ({\n          componente: c.json['Componente'],\n          quantidade: Number(c.json['Quantidade'])\n        }));\n      faltamDetalhes.push({\n        produto: produto,\n        qtdFalta: qtdProduzir,\n        margem: margemAtual,\n        idOS: idOS,\n        componentes: estruturaComps\n      });\n    }\n\n    results.push({\n      json: {\n        CLIENTE: cliente,\n        PRODUTO: produto,\n        QTD: quantidade,\n        N_PEDIDO: nPedido,\n        DATA: data,\n        OBS: obs,              // ← OBS original do vendedor\n        'SITUAÇÃO': situacao,  // ← campo do sistema\n        'PRODUÇÃO': producao,\n        FALTAM: JSON.stringify(faltamDetalhes),\n        row_number: rowNumber,\n        _tipo: 'MONTAGEM'\n      }\n    });\n\n    if (!osGerada[produto]) {\n      if (estoqueApos < margemAtual || estoqueApos < 0) {\n        const qtdProduzir = margemAtual > 0 ? margemAtual - estoqueApos : Math.abs(estoqueApos);\n        const componentes = $('Get row(s) in sheet4').all()\n          .filter(c => c.json['Produto'] === produto);\n\n        for (const comp of componentes) {\n          const qtdComp = Number(comp.json['Quantidade']) * qtdProduzir;\n          results.push({\n            json: {\n              ID_OS: idOS,\n              PRODUTO: comp.json['Produto'],\n              COMPONENTES: comp.json['Componente'],\n              QTD: qtdComp,\n              DATA: data,\n              OPERADOR: '',\n              STATUS: '',\n              QTD_PROD_FINAL: qtdProduzir,\n              OBS: 'REPOSIÇÃO',\n              CLIENTE: 'ESTOQUE',\n              N_PEDIDO: 'INTERNO',\n              row_number: rowNumber,\n              _tipo: 'OS'\n            }\n          });\n        }\n        osGerada[produto] = true;\n      }\n    }\n\n  } else {\n    const componentes = $('Get row(s) in sheet4').all()\n      .filter(c => c.json['Produto'] === produto);\n\n    for (const comp of componentes) {\n      const qtdComp = Number(comp.json['Quantidade']) * quantidade;\n      results.push({\n        json: {\n          ID_OS: idOS,\n          PRODUTO: comp.json['Produto'],\n          COMPONENTES: comp.json['Componente'],\n          QTD: qtdComp,\n          DATA: data,\n          OPERADOR: '',\n          STATUS: '',\n          QTD_PROD_FINAL: quantidade,\n          OBS: obs,\n          CLIENTE: cliente,\n          N_PEDIDO: nPedido,\n          row_number: rowNumber,\n          _tipo: 'OS'\n        }\n      });\n    }\n  }\n}\n\nfor (const [produto, info] of Object.entries(estoqueCalc)) {\n  results.push({\n    json: {\n      PRODUTO: produto,\n      TOTAL_PEDIDO: info.qtd,\n      QTD_NOVA: info.qtdDisponivel - info.qtd,\n      row_number: info.row_number,\n      _tipo: 'ESTOQUE'\n    }\n  });\n}\n\nreturn results;"
      },
